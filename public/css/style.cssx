
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body {
  height: 100%; overflow: hidden; background: #000;
  font-family: system-ui, -apple-system, sans-serif;
  user-select: none; -webkit-user-select: none;
}

#paper {
  position: fixed; top: 0; left: 0;
  width: 100vw; height: 100vh;
  transform-origin: 0 0;
  transform: translate(0, 0) scale(1);
  z-index: 1;
  will-change: transform;
}
#paper > canvas {
  position: absolute; top: 0; left: 0;
  width: 100vw; height: 100vh;
  touch-action: none;
  pointer-events: none;
}
#paper > #board { pointer-events: auto; }
body.hand-mode #paper > #board,
body.text-mode #paper > #board,
body.shapes-mode #paper > #board { pointer-events: none; }
body.text-mode #paper > #textCanvas     { pointer-events: auto; }
body.shapes-mode #paper > #shapesCanvas { pointer-events: auto; }

#handOverlay {
  position: fixed; inset: 0;
  z-index: 6;
  display: none;
  touch-action: none;
  cursor: grab;
}
body.hand-mode #handOverlay { display: block; pointer-events: auto; }

#bgCanvas      { background: #fff; z-index: 1; }
#board         { z-index: 2; background: transparent; }
#previewCanvas { z-index: 3; background: transparent; }
#shapesCanvas  { z-index: 4; background: transparent; }
#textCanvas    { z-index: 5; background: transparent; }

.toolbar {
  position: fixed; bottom: 14px; left: 50%;
  transform: translateX(-50%);
  display: flex; align-items: center; gap: 6px;
  background: linear-gradient(180deg, rgba(30,30,30,0.92), rgba(15,15,15,0.92));
  padding: 8px; border-radius: 22px; z-index: 10;
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  max-width: calc(100vw - 16px);
  overflow-x: auto; scrollbar-width: none;
  box-shadow: 0 8px 32px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.06);
}
.toolbar::-webkit-scrollbar { display: none; }

.btn {
  background: rgba(255,255,255,0.95);
  border: none; min-width: 42px; height: 42px;
  border-radius: 12px; cursor: pointer; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  color: #1a1a1a; font-size: 18px; padding: 0 10px;
}
.btn:disabled { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.25); cursor: not-allowed; }
.btn.active { background: linear-gradient(135deg, #ffd54f, #ffb300); box-shadow: 0 0 0 2px rgba(255,213,79,0.3); }
.btn.heart { background: linear-gradient(135deg, #ff5c8a, #e91e63); color: #fff; font-size: 20px; }
.btn.privacy-off { background: linear-gradient(135deg, #6b6b6b, #424242); color: #fff; }
#emojiMuteBtn { font-size: 18px; }
#emojiMuteBtn.muted { background: linear-gradient(135deg, #e53935, #b71c1c); color: #fff; box-shadow: 0 0 0 2px rgba(229,57,53,0.4); }
#textBtn { font-weight: 800; font-family: Georgia, serif; font-size: 22px; line-height: 1; }
#shapeBtn { font-size: 22px; }
#toolsBtn { font-size: 20px; }
#presetsBtn { font-size: 18px; }
#undoBtn, #redoBtn { font-size: 22px; font-weight: 700; }

.color-picker {
  width: 42px; height: 42px; border-radius: 12px; border: none; cursor: pointer;
  background: conic-gradient(from 0deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
  position: relative; padding: 0; flex-shrink: 0;
}
.color-picker::after {
  content: ''; position: absolute; inset: 9px;
  border-radius: 6px; background: var(--current-color, #000);
  border: 2px solid rgba(255,255,255,0.9);
}
.slider-wrap { display: flex; align-items: center; padding: 0 4px; flex-shrink: 0; }
.slider-wrap input { width: 70px; accent-color: #ffd54f; }

.topbar {
  position: fixed; top: 12px; right: 12px;
  display: flex; gap: 6px; z-index: 10;
  background: linear-gradient(180deg, rgba(30,30,30,0.85), rgba(15,15,15,0.85));
  padding: 6px; border-radius: 18px;
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  border: 1px solid rgba(255,255,255,0.06);
}
.topbar .btn { min-width: 40px; height: 40px; font-size: 17px; }

.tools-panel {
  position: fixed; bottom: 78px; left: 50%;
  transform: translateX(-50%);
  display: none; gap: 8px;
  background: linear-gradient(180deg, rgba(30,30,30,0.95), rgba(15,15,15,0.95));
  padding: 10px; border-radius: 18px; z-index: 20;
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.6);
  border: 1px solid rgba(255,255,255,0.08);
}
.tools-panel.open { display: flex; }
.tool-btn {
  width: 52px; height: 52px;
  background: rgba(255,255,255,0.08);
  border: none; border-radius: 14px;
  color: #fff; font-size: 22px;
  cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
}
.tool-btn.active { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #1a1a1a; box-shadow: 0 0 0 2px rgba(255,213,79,0.3); }

.text-toolbar {
  position: fixed; bottom: 78px; left: 50%;
  transform: translateX(-50%);
  display: none; gap: 6px;
  background: linear-gradient(180deg, rgba(30,30,30,0.95), rgba(15,15,15,0.95));
  padding: 8px; border-radius: 18px; z-index: 15;
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.6);
  border: 1px solid rgba(255,255,255,0.08);
  max-width: calc(100vw - 16px);
  overflow-x: auto; scrollbar-width: none; white-space: nowrap;
}
.text-toolbar.open { display: flex; }
.text-toolbar::-webkit-scrollbar { display: none; }
.tt-btn {
  background: rgba(255,255,255,0.12); border: none; color: #fff;
  min-width: 44px; height: 44px; border-radius: 12px;
  cursor: pointer; font-size: 20px; font-weight: 700;
  flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
}
.tt-btn.danger { background: rgba(220,50,70,0.7); }
.tt-btn.close  { background: rgba(80,80,80,0.6); }

.palette, .presets-panel {
  position: fixed; left: 8px; right: 8px;
  bottom: 78px; margin: 0 auto;
  max-width: 380px; max-height: calc(100vh - 110px);
  overflow-y: auto;
  background: linear-gradient(180deg, #232323, #171717);
  padding: 14px; border-radius: 20px; z-index: 100;
  display: none;
  box-shadow: 0 20px 60px rgba(0,0,0,0.75);
  border: 1px solid rgba(255,255,255,0.08);
}
.palette.open, .presets-panel.open { display: block; }

.palette-header, .presets-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 10px;
}
.palette-header h3, .presets-header h3 { color: #fff; font-size: 16px; font-weight: 700; }
.palette-close {
  background: rgba(255,255,255,0.1);
  border: none; width: 32px; height: 32px;
  border-radius: 50%; color: #fff; font-size: 16px;
  cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
}

.palette-section-label {
  display: block;
  color: #888; font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 10px 0 8px; font-weight: 600;
}

.base-colors { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; }
.base-color {
  aspect-ratio: 1;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15);
  cursor: pointer; padding: 0;
}
.base-color.selected { border-color: #ffd54f; box-shadow: 0 0 0 2px rgba(255,213,79,0.4); }

.mode-switch { display: flex; gap: 6px; margin-bottom: 12px; }
.mode-btn {
  flex: 1; padding: 10px; border: none; border-radius: 10px;
  background: rgba(255,255,255,0.06); color: #ccc;
  cursor: pointer; font-size: 13px;
}
.mode-btn.active { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #1a1a1a; font-weight: 700; }
.palette .preview { width: 100%; height: 42px; border-radius: 12px; border: 2px solid rgba(255,255,255,0.1); margin-bottom: 12px; }
.picker-view { position: relative; margin-bottom: 12px; display: flex; flex-direction: column; align-items: center; }
#wheelCanvas { border-radius: 50%; touch-action: none; }
#hueCanvas   { border-radius: 8px; touch-action: none; margin-bottom: 10px; }
#svCanvas    { border-radius: 8px; touch-action: none; }
.wheel-cursor, .hue-cursor, .sv-cursor {
  position: absolute; border: 3px solid #fff;
  box-shadow: 0 0 0 1px rgba(0,0,0,0.8);
  pointer-events: none; border-radius: 50%;
  width: 16px; height: 16px; transform: translate(-50%, -50%);
}
.hue-cursor, .sv-cursor { border-radius: 4px; width: 10px; height: 22px; border-width: 2px; }
.palette .row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.palette label { color: #ddd; font-size: 13px; width: 18px; font-weight: 700; font-family: monospace; }
.palette input[type="range"] { flex: 1; accent-color: #ffd54f; }
.palette .val { color: #999; font-size: 12px; width: 40px; text-align: right; font-family: monospace; }
.palette .hex { display: flex; gap: 8px; margin-top: 8px; }
.palette .hex input {
  flex: 1; padding: 10px 12px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.1); background: #0d0d0d; color: #fff;
  font-family: monospace; font-size: 15px; min-width: 0;
}
.palette .hex button {
  background: linear-gradient(135deg, #ffd54f, #ffb300);
  border: none; padding: 10px 22px; border-radius: 10px;
  font-weight: 700; cursor: pointer; color: #1a1a1a; font-size: 14px;
  flex-shrink: 0;
}

/* ===== ПАНЕЛЬ ПРЕСЕТОВ ===== */
.presets-list {
  display: flex; flex-direction: column; gap: 8px;
}
.preset-item {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  color: #fff; font-size: 14px;
  cursor: pointer;
  text-align: left;
  transition: background 0.12s, transform 0.12s;
}
.preset-item:hover,
.preset-item:active { background: rgba(255,255,255,0.12); transform: scale(0.99); }

.preset-tool {
  font-size: 22px;
  width: 30px; text-align: center;
  flex-shrink: 0;
}
.preset-color {
  width: 26px; height: 26px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.6);
  flex-shrink: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,0.4);
}
.preset-name {
  flex: 1;
  color: #eee;
  font-weight: 500;
  font-size: 14px;
}
.preset-size {
  color: #bbb;
  font-family: monospace;
  font-size: 13px;
  flex-shrink: 0;
}
.presets-empty {
  color: #777;
  font-size: 13px;
  padding: 16px 8px;
  text-align: center;
  line-height: 1.5;
}

.modal, .text-modal, .emoji-modal {
  position: fixed; inset: 0; background: rgba(0,0,0,0.88);
  display: none; z-index: 300; overflow-y: auto; padding: 20px;
  backdrop-filter: blur(6px);
}
.modal.open, .text-modal.open, .emoji-modal.open { display: block; }
.modal h2 { color: #fff; margin-bottom: 16px; font-size: 20px; font-weight: 700; }
.modal .close {
  position: fixed; top: 14px; right: 14px;
  background: rgba(255,255,255,0.9); border: none; border-radius: 50%;
  width: 40px; height: 40px; font-size: 20px; cursor: pointer;
  color: #111; font-weight: 700;
}
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.grid .item { background: #222; border-radius: 12px; overflow: hidden; }
.grid img { width: 100%; display: block; }
.grid .actions { display: flex; gap: 4px; padding: 6px; background: #0f0f0f; }
.grid .actions a, .grid .actions button {
  flex: 1; text-align: center; font-size: 12px; padding: 8px;
  border: none; border-radius: 8px;
  background: rgba(255,255,255,0.1); color: #fff; text-decoration: none; cursor: pointer;
}
.grid .actions button.del { background: rgba(220,50,70,0.7); }

.text-modal-inner {
  background: linear-gradient(180deg, #232323, #1a1a1a);
  padding: 18px; border-radius: 20px;
  max-width: 440px; margin: 0 auto;
  box-shadow: 0 20px 60px rgba(0,0,0,0.7);
  border: 1px solid rgba(255,255,255,0.06);
}
.text-modal h2 { color: #fff; font-size: 20px; margin-bottom: 14px; font-weight: 700; }
.tm-label { display: block; color: #bbb; font-size: 13px; margin: 12px 0 6px; font-weight: 500; }
.text-modal textarea,
.text-modal input[type="text"] {
  width: 100%; padding: 12px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.1);
  background: #0d0d0d; color: #fff;
  font-size: 15px; font-family: inherit; resize: vertical;
}
.tm-row { display: flex; align-items: center; gap: 12px; }
.tm-row input[type="color"] {
  width: 52px; height: 40px;
  border: 1px solid rgba(255,255,255,0.1);
  background: transparent; border-radius: 10px;
  cursor: pointer; padding: 2px;
}
.tm-val { color: #aaa; font-size: 13px; font-family: monospace; }
.text-modal input[type="range"] { width: 100%; accent-color: #ffd54f; }

.shape-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 10px; }
.shape-btn {
  aspect-ratio: 1;
  background: rgba(255,255,255,0.05);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: 12px; color: #fff; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  padding: 8px;
}
.shape-btn svg { width: 100%; height: 100%; max-width: 40px; max-height: 40px; }
.shape-btn.active { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #1a1a1a; border-color: transparent; }

.font-picker { position: relative; }
.font-picker-btn {
  width: 100%; display: flex; align-items: center; justify-content: space-between;
  padding: 12px 14px; background: #0d0d0d;
  border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;
  color: #fff; font-size: 16px; cursor: pointer; text-align: left;
}
.font-picker-label { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.font-picker-arrow { color: #888; margin-left: 8px; }
.font-picker-list {
  display: none; position: absolute;
  top: calc(100% + 4px); left: 0; right: 0;
  background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px; max-height: 260px; overflow-y: auto;
  z-index: 10; box-shadow: 0 12px 40px rgba(0,0,0,0.6);
}
.font-picker-list.open { display: block; }
.font-picker-item {
  display: block; width: 100%; padding: 12px 14px;
  background: transparent; border: none;
  color: #fff; font-size: 18px; text-align: left; cursor: pointer;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.font-picker-item:hover,
.font-picker-item.active { background: rgba(255,213,79,0.15); }

.tm-buttons { display: flex; gap: 8px; }
.tm-toggle {
  flex: 1; padding: 12px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.05); color: #fff;
  cursor: pointer; font-size: 14px; font-weight: 600;
}
.tm-toggle.active { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #1a1a1a; border-color: transparent; }

.tm-subrow {
  display: grid; grid-template-columns: 80px 1fr;
  gap: 8px 12px; align-items: center;
  color: #aaa; font-size: 12px; margin-top: 8px;
}
.tm-subrow input[type="color"] {
  width: 52px; height: 32px;
  border: 1px solid rgba(255,255,255,0.1);
  background: transparent; border-radius: 8px;
  cursor: pointer; padding: 2px;
}
.tm-preview-wrap {
  margin: 16px 0; border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px; overflow: hidden; background: #fff;
}
#tmPreview, #shPreview { display: block; width: 100%; }
.tm-actions { display: flex; gap: 10px; margin-top: 12px; }
.tm-btn {
  flex: 1; padding: 14px; border-radius: 12px; border: none;
  cursor: pointer; font-size: 15px; font-weight: 700;
}
.tm-btn.cancel { background: rgba(255,255,255,0.1); color: #fff; }
.tm-btn.ok { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #1a1a1a; }

.er-color-list {
  display: flex; flex-wrap: wrap; gap: 8px;
  min-height: 42px; padding: 8px;
  background: #0d0d0d;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
}
.er-hint { color: #777; font-size: 13px; padding: 4px 6px; }
.er-chip {
  position: relative;
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.8);
}
.er-chip-x {
  position: absolute;
  top: -6px; right: -6px;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: #e53935; color: #fff;
  border: 2px solid #fff;
  font-size: 12px; line-height: 1;
  cursor: pointer; padding: 0;
  display: flex; align-items: center; justify-content: center;
}

.emoji-modal-inner {
  background: linear-gradient(180deg, #232323, #1a1a1a);
  padding: 18px; border-radius: 20px;
  max-width: 460px; margin: 0 auto;
  box-shadow: 0 20px 60px rgba(0,0,0,0.7);
  border: 1px solid rgba(255,255,255,0.06);
}
.emoji-modal h2 { color: #fff; font-size: 20px; margin-bottom: 14px; font-weight: 700; }

.emoji-tabs {
  display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
  padding-bottom: 6px; margin-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.emoji-tabs::-webkit-scrollbar { display: none; }
.emoji-tab {
  flex-shrink: 0;
  padding: 8px 14px;
  background: rgba(255,255,255,0.06);
  border: none; border-radius: 10px;
  color: #ccc; font-size: 13px;
  cursor: pointer; white-space: nowrap;
}
.emoji-tab.active { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #1a1a1a; font-weight: 700; }

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px; max-height: 340px; overflow-y: auto;
  padding: 4px 0; margin-bottom: 12px;
}
.emoji-btn {
  aspect-ratio: 1;
  background: transparent;
  border: none; border-radius: 8px;
  font-size: 26px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  padding: 0;
}
.emoji-btn.selected { background: rgba(255,213,79,0.3); box-shadow: 0 0 0 2px #ffd54f inset; }

#hearts { position: fixed; inset: 0; pointer-events: none; z-index: 50; overflow: hidden; }
.flying-heart {
  position: absolute; bottom: -50px; font-size: 32px;
  animation: flyUp linear forwards;
  filter: drop-shadow(0 2px 6px rgba(255,80,120,0.4));
  will-change: transform, opacity;
}
@keyframes flyUp {
  0%   { transform: translateY(0) scale(0.6) rotate(0deg); opacity: 0; }
  10%  { opacity: 1; }
  100% { transform: translateY(-110vh) scale(1.2) rotate(360deg); opacity: 0; }
}
.hidden-file { display: none; }

.toast {
  position: fixed; top: 70px; left: 50%;
  transform: translateX(-50%) translateY(-20px);
  background: linear-gradient(135deg, rgba(229,57,53,0.95), rgba(183,28,28,0.95));
  color: #fff; padding: 14px 22px;
  border-radius: 14px; font-size: 14px; font-weight: 600;
  z-index: 500;
  box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  opacity: 0;
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
  max-width: calc(100vw - 40px); text-align: center;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast.success { background: linear-gradient(135deg, rgba(67,160,71,0.95), rgba(27,94,32,0.95)); }
